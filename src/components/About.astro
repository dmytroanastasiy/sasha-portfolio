---
// About.astro
const education = [
  { years: "2024 – 2027", title: "Industrial Product Design", place: "Howest (Kortrijk)" },
  { years: "2018 – 2022", title: "Art & Design", place: "Riga Maras Muiznieces Art School" },
  { years: "2016 – 2024", title: "Fine Arts", place: "Jurmala art school" },
];

const skillGroups = [
  {
    label: "Software & skills",
    items: ["Autodesk Fusion", "Siemens NX", "Adobe Ps / Ai / Id", "Blender", "Sketching", "Prototyping"],
  },
  {
    label: "Materials",
    items: ["Metal", "Plastic", "Wood", "Wood", "Clay", "Textile"],
  },
  {
    label: "Languages",
    items: ["English (C1)", "French (B2)", "Latvian (native)", "Russian (Native)"],
  },
];


---

<section class="about" id="about">
  <div class="about-top">
    <h2 class="about-heading">Hey, I'm Aleksandra,<br />I do industrial design!</h2>
    </ul>
  </div>

  <hr class="about-divider" />

  <div class="about-grid">
    <div class="card bio-card">
      <p>
        I'm an industrial product designer finishing my bachelor's in
        Industrial Product Design (IPO) at Howest. I've designed for real
        clients through university coursework, working from brief through
        to tested prototype.
      </p>
      <p>
        I care about designing things that actually get made — and made
        responsibly: I start from research, prototype hands-on rather than
        staying in renders, and I'm fluent enough in CAD to know whether an
        idea is manufacturable and low-impact before it ever leaves the
        sketch stage.
      </p>

      <span class="card-label">Education</span>
      <ul class="timeline">
        {education.map((entry) => (
          <li>
            <span class="timeline-years">{entry.years}</span>
            <span class="timeline-content">
              <strong>{entry.title}</strong>
              <span class="timeline-place">{entry.place}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div class="skills-column">
      {skillGroups.map((group) => (
        <div class="card">
          <span class="card-label">{group.label}</span>
          <div class="pills">
            {group.items.map((item) => <span class="pill">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about {
    background: #f1efeb;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 5vw, 4rem);
    font-family: system-ui, -apple-system, sans-serif; /* swap for your body font */
    color: #1a1a1a;
  }

  .about-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .about-heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  

  .about-socials li + li {
    margin-top: 0.5rem;
  }

  

  .about-divider {
    border: none;
    border-top: 1px solid #7a3b3b;
    margin: 3rem 0 3rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .card {
    background: #fff;
    border-radius: none;
    padding: 1.75rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .bio-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #333;
    margin: 0 0 1.25rem;
  }

  .card-label {
    display: block;
    font-size: 0.8rem;
    color: #999;
    margin-bottom: 1rem;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 0;
  }

  .timeline-years {
    font-weight: 700;
    color: #888;
    font-size: 0.9rem;
  }

  .timeline-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .timeline-content strong {
    font-size: 1rem;
  }

  .timeline-place {
    color: #888;
    font-size: 0.85rem;
  }

  .skills-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .pill {
    background: #ececea;
    border-radius: none;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  /* Desktop — two-column layout, socials reappear, timeline goes side-by-side */
  @media (min-width: 900px) {
    .about-socials {
      display: block;
    }

    .about-grid {
      grid-template-columns: 1fr 1fr;
    }

    .timeline li {
      flex-direction: row;
      align-items: baseline;
      gap: 1.5rem;
    }

    .timeline-years {
      flex: 0 0 100px;
    }
  }
</style>