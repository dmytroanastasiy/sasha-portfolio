---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkCard from "../components/WorkCard.astro";
import About from "../components/About.astro";
import Works from "../components/Works.astro";
import Counter from "../components/Counter.jsx";
import { getCollection } from "astro:content";

// Dynamically import all images from src/assets
const globImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpeg,jpg,png,gif,webp}",
  { eager: true }
);

// Cursor trail: small webp copies (they show at 120px wide), not the
// multi-MB originals, and never the favicon or placeholder.
const heroImageUrls = await Promise.all(
  Object.entries(globImages)
    .filter(([path]) => !/favicon|placeholder/.test(path))
    .map(async ([, img]) => {
      const small = await getImage({ src: img.default, width: 280, format: "webp", quality: 72 });
      return small.src;
    })
);

const works = (await getCollection("works")).sort((a, b) => a.data.order - b.data.order);
const skills = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout pageTitle="Home">
  <section class="hero" id="hero-section" data-images={JSON.stringify(heroImageUrls)}>
    <h1 class="hero-title" id="liquid-title" aria-label="portfolio">{[..."portfolio"].map((char) => <span class="fluid-letter" aria-hidden="true">{char}</span>)}</h1>
  </section>

  <About />
  <Works />
</BaseLayout>

<script>
  import { fluidLetters } from "../scripts/fluid-letters";

  /* "portfolio": liquid silver letters that run from the cursor */
  const title = document.getElementById("liquid-title");
  if (title) fluidLetters(title, { silver: true, push: 0.45, reach: 0.95 });

  /* Cursor image trail
     Images are small webp copies, decoded up front, and shown from a
     fixed pool of <img> elements animated on the GPU, so nothing is
     created, loaded or laid out while the mouse moves. */
  const hero = document.getElementById("hero-section");
  const images: string[] = hero?.dataset.images ? JSON.parse(hero.dataset.images) : [];

  if (hero && images.length && window.matchMedia("(hover: hover)").matches) {
    // Download and decode every image once, ahead of time
    const preloaded = images.map((src) => {
      const img = new Image();
      img.src = src;
      img.decode().catch(() => {});
      return img;
    });

    const POOL_SIZE = 12;
    const pool = Array.from({ length: POOL_SIZE }, () => {
      const img = document.createElement("img");
      img.className = "hero-trail-img";
      img.alt = "";
      img.decoding = "async";
      document.body.appendChild(img);
      return img;
    });

    let next = 0;
    let lastSrc = -1;
    let lastX = 0;
    let lastY = 0;
    const distanceThreshold = 85; // pixels moved before the next image

    function spawn(x: number, y: number) {
      let pick = Math.floor(Math.random() * preloaded.length);
      if (pick === lastSrc && preloaded.length > 1) pick = (pick + 1) % preloaded.length;
      lastSrc = pick;

      const img = pool[next];
      next = (next + 1) % POOL_SIZE;

      img.getAnimations().forEach((a) => a.cancel());
      img.src = preloaded[pick].src;
      img.style.translate = `calc(${x}px - 50%) calc(${y}px - 50%)`;

      const rotate = `${((Math.random() - 0.5) * 24).toFixed(1)}deg`;
      img.animate(
        [
          { opacity: 0, scale: "0.7", rotate },
          { opacity: 1, scale: "1", rotate, offset: 0.3 },
          { opacity: 1, scale: "1", rotate, offset: 0.5 },
          { opacity: 0, scale: "0.85", rotate },
        ],
        { duration: 800, easing: "cubic-bezier(0.16, 1, 0.3, 1)", fill: "forwards" }
      );
    }

    hero.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType !== "mouse") return;
        if (Math.hypot(e.clientX - lastX, e.clientY - lastY) > distanceThreshold) {
          lastX = e.clientX;
          lastY = e.clientY;
          spawn(e.clientX, e.clientY);
        }
      },
      { passive: true }
    );
  }
</script>

<style>
  .hero {
    height: 70dvh;
    width: 100vw;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    background-color: #0f0f0f;
    margin-top: -0.1rem;
    position: relative;
    overflow: hidden;
  }

  .hero-title {
    color: #d8d8d8;
    font-family: "Bodoni 72", "Bodoni MT", Didot, serif;
    font-style: italic;
    font-weight: 200;
    text-align: center;
    margin: 0;
    margin-bottom: 1.5rem;
    font-size: clamp(3rem, 10vw, 12.5rem);
    letter-spacing: clamp(0.1em, 4vw, 3em);
    padding-left: 1rem;
    z-index: 9999;
    user-select: none;
  }

  /* ---------- Liquid silver ----------
     Painted per letter, but every layer is sized to the whole word and
     shifted by the letter's place in it (--bx), so the metal reads as one
     surface. Vars come from src/scripts/fluid-letters.ts. */
  .hero-title :global(.fluid-letter) {
    display: inline-block;
    /* room for italic overhangs and descenders inside the painted box */
    padding: 0.12em 0.22em;
    margin: -0.12em -0.22em;
    transform-origin: 50% 80%;
    will-change: transform;

    color: transparent;
    -webkit-text-fill-color: transparent;
    background-image:
      /* reflection that follows the cursor */
      radial-gradient(
        1.1em 0.8em at var(--mx, -999px) var(--my, -999px),
        rgba(255, 255, 255, calc(0.75 * var(--glow-a, 0))),
        rgba(255, 255, 255, 0)
      ),
      /* sheen that sweeps across now and then */
      linear-gradient(
        104deg,
        rgba(255, 255, 255, 0) 45%,
        rgba(255, 255, 255, 0.85) 50%,
        rgba(255, 255, 255, 0) 55%
      ),
      /* the chrome itself: sky, horizon, ground reflection */
      linear-gradient(
        calc(180deg + var(--tilt, 0deg)),
        #ffffff 0%,
        #f4f4f4 30%,
        #d2d2d2 42%,
        #8e8e8e 49%,
        #262626 50.5%,
        #575757 53%,
        #b9b9b9 61%,
        #fbfbfb 71%,
        #d9d9d9 84%,
        #9c9c9c 100%
      );
    background-size:
      var(--ww, 100%) 100%,
      calc(var(--ww, 100%) * 3) 100%,
      100% 170%;
    background-position:
      calc(var(--bx, 0px) * -1) 0,
      calc(var(--sheen, -9999px) - var(--bx, 0px)) 0,
      0 calc(var(--hh, 1em) * (var(--hy, 0) - 0.25));
    background-repeat: no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* Cursor trail images (a fixed pool, positioned with `translate`
     and animated with the Web Animations API) */
  :global(.hero-trail-img) {
    position: fixed;
    top: 0;
    left: 0;
    width: 120px;
    height: auto;
    object-fit: contain;
    pointer-events: none;
    z-index: 1000;
    opacity: 0;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);
    border-radius: 4px;
    will-change: transform, opacity;
  }
</style>
